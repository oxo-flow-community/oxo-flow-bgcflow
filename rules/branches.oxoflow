log = "logs/ppanggolin/genome_roary/tile_plot_nocloud_{config.project}.log"
tags = ["pangenome", "ppanggolin"]
shell = """
mkdir -p logs/ppanggolin/genome_roary 2>> {log}
ppanggolin draw -f -p {input[0]} --tile_plot --nocloud --output {output[0]} 2>> {log}
"""
[rules.environment]
conda = "envs/ppanggolin.yaml"

[[rules]]
