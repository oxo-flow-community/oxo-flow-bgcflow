log = "logs/ppanggolin/genome/write_regions_{config.project}.log"
tags = ["pangenome", "ppanggolin"]
shell = """
mkdir -p logs/ppanggolin/genome 2>> {log}
ppanggolin write -f -p {input[0]} --regions --output {output[0]} 2>> {log}
"""
[rules.environment]
conda = "envs/ppanggolin.yaml"

