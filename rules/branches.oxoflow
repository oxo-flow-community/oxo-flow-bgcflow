[[rules]]
name = "ppanggolin_genome_roary"
description = "roary-seeded pangenome analysis over the prokka GFFs (upstream ppanggolin_genome_roary)"
when = "config.run_ppanggolin"
expand_inputs = [
    { pattern = "data/interim/prokka/{sample}/{sample}.gff", variables = { sample = "config.samples_list" } }
]
input = ["data/interim/roary/{config.project}"]
output = [
    "data/processed/{config.project}/ppanggolin/genome_roary/pangenome.h5",
    "data/processed/{config.project}/ppanggolin/genome_roary/rarefaction",
    "data/processed/{config.project}/ppanggolin/genome_roary/msa_core",
    "data/processed/{config.project}/ppanggolin/genome_roary/msa_phylo",
]
log = "logs/ppanggolin/genome_roary/ppanggolin_roary_{config.project}.log"
tags = ["pangenome", "ppanggolin"]
shell = """
mkdir -p logs/ppanggolin/genome_roary data/interim/tmp/ppanggolin/{config.project} 2>> {log}
TMPDIR="data/interim/tmp/ppanggolin/{config.project}"
OUTDIR=$(dirname {output[0]})
mkdir -p $OUTDIR
INPUT_GFF="$TMPDIR/prokka_gff_roary.txt"
ORGANISM_ANNOTATION_LIST="$TMPDIR/ORGANISM_ANNOTATION_LIST_roary.txt"
CLUSTERS_FILE="$TMPDIR/CLUSTERS_FILE.txt"
echo '{input}' > $INPUT_GFF
echo "Preparing input data for ppanggolin..." >> {log}
python scripts/prep_ppanggolin_from_roary.py "$INPUT_GFF" "$ORGANISM_ANNOTATION_LIST" 2>> {log}
echo "Converting Roary output to mmseqs2 format" >> {log}
python scripts/prep_roary_cluster_to_mmseqs2_format.py {input[0]}/clustered_proteins $CLUSTERS_FILE 2>> {log}
echo "##### 1 Running ppanggolin annotate... #####" >> {log}
ppanggolin annotate --cpu {threads} --anno $ORGANISM_ANNOTATION_LIST --output $OUTDIR --force --verbose 1 2>> {log}
echo "##### 2 Running ppanggolin cluster... #####" >> {log}
ppanggolin cluster --cpu {threads} --identity 0.8 --coverage 0.8 -p {output[0]} --clusters $CLUSTERS_FILE --infer_singletons --verbose 1 2>> {log}
echo "##### 3. Building pangenome graph with ppanggolin graph... #####" >> {log}
ppanggolin graph -p {output[0]} --cpu {threads} --verbose 1 2>> {log}
echo "##### 3. Partitioning graph with ppanggolin partition... #####" >> {log}
ppanggolin partition -p {output[0]} --cpu {threads} --verbose 1 2>> {log}
echo "#### 4. Predicting region of genome plasticity with ppanggolin rgp... ####" >> {log}
ppanggolin rgp -p {output[0]} --cpu {threads} --verbose 1 2>> {log}
echo "#### 5. Finding spots of insertion with ppanggolin spot... ####" >> {log}
ppanggolin spot -p {output[0]} --cpu {threads} --verbose 1 2>> {log}
echo "#### 6. Finding conserved modules with ppanggolin module... ####" >> {log}
ppanggolin module -p {output[0]} --cpu {threads} --verbose 1 2>> {log}
echo "#### 7. Calculating rarefaction curves with ppanggolin rarefaction... ####" >> {log}
ppanggolin rarefaction -f --min 5 --max 50 --depth 30 -p {output[0]} --cpu {threads} --output {output[1]} 2>> {log}
echo "#### 8. Building trees using ppanggolin msa... ####" >> {log}
ppanggolin msa -f -p {output[0]} --partition core --output {output[2]} 2>> {log}
ppanggolin msa -f -p {output[0]} --phylo --output {output[3]} 2>> {log}
"""
[rules.environment]
conda = "envs/ppanggolin.yaml"

[[rules]]
name = "ppanggolin_genome_roary_write_regions"
description = "write RGP regions from the roary-seeded pangenome (upstream ppanggolin_genome_roary_write_regions)"
when = "config.run_ppanggolin"
input = [
