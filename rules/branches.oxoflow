"""
[rules.environment]
conda = "envs/ppanggolin.yaml"

[[rules]]
name = "ppanggolin_genome_roary_draw_ucurve"
description = "draw the U-shaped presence/absence curve (upstream ppanggolin_genome_roary_draw_ucurve)"
when = "config.run_ppanggolin"
input = [
    "data/processed/{config.project}/ppanggolin/genome_roary/pangenome.h5",
    "data/processed/{config.project}/ppanggolin/genome_roary/spots",
]
output = ["data/processed/{config.project}/ppanggolin/genome_roary/ucurve"]
log = "logs/ppanggolin/genome_roary/draw_ucurve_{config.project}.log"
tags = ["pangenome", "ppanggolin"]
shell = """
mkdir -p logs/ppanggolin/genome_roary 2>> {log}
ppanggolin draw -f -p {input[0]} --ucurve --output {output[0]} 2>> {log}
"""
[rules.environment]
conda = "envs/ppanggolin.yaml"

[[rules]]
name = "ppanggolin_genome_roary_draw_tile_plot"
description = "draw the tile plot (upstream ppanggolin_genome_roary_draw_tile_plot)"
when = "config.run_ppanggolin"
input = [
    "data/processed/{config.project}/ppanggolin/genome_roary/pangenome.h5",
    "data/processed/{config.project}/ppanggolin/genome_roary/ucurve",
]
output = ["data/processed/{config.project}/ppanggolin/genome_roary/tile_plot"]
log = "logs/ppanggolin/genome_roary/tile_plot_{config.project}.log"
tags = ["pangenome", "ppanggolin"]
shell = """
mkdir -p logs/ppanggolin/genome_roary 2>> {log}
ppanggolin draw -f -p {input[0]} --tile_plot --output {output[0]} 2>> {log}
"""
[rules.environment]
conda = "envs/ppanggolin.yaml"

[[rules]]
name = "ppanggolin_genome_roary_draw_tile_plot_nocloud"
description = "draw the tile plot without cloud genes (upstream ppanggolin_genome_roary_draw_tile_plot_nocloud)"
